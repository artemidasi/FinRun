{
  "name": "Artemida Config",
  "version": "0.1.0",
  "homepage": "./",
  "private": false,
  "dependencies": {
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@internationalized/date": "^3.0.0",
    "@mui/icons-material": "^5.8.4",
    "@reduxjs/toolkit": "^1.8.2",
    "axios": "^0.19.2",
    "classnames": "^2.3.1",
    "formik": "^2.2.9",
    "framer-motion": "^6.3.15",
    "next": "^12.0.9",
    "randomcolor": "^0.6.2",
    "react": "^17.0.2",
    "react-datepicker": "^4.8.0",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.0",
    "react-scripts": "^4.0.3",
    "react-select": "^5.3.2",
    "react-tabs": "^4.2.1",
    "react-use": "^15.3.4",
    "react-uuid": "^1.0.2",
    "recharts": "^2.1.12",
    "redux": "^4.0.5",
    "redux-mock-store": "^1.5.4",
    "sass": "^1.82.0",
    "yup": "^0.32.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "start": "next start",
    "test:coverage": "yarn test --watchAll false --coverage",
    "prettier": "prettier --parser typescript --single-quote --write \"src/**/*.{ts,tsx}\"",
    "stylelint": "npx stylelint \"**/*.{css,scss}\" --fix",
    "eslint": "eslint src/ --ext=.ts,.tsx --fix",
    "typecheck": "bash -c tsc --noEmit",
    "prepare": "husky install"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "safari >= 11"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^7.21.1",
    "@testing-library/jest-dom": "^5.11.1",
    "@testing-library/react": "^10.4.7",
    "@testing-library/user-event": "^12.0.11",
    "@types/jest": "^26.0.5",
    "@types/node": "^14.0.23",
    "@types/randomcolor": "^0.5.6",
    "@types/react": "^17.0.0",
    "@types/react-datepicker": "^4.4.2",
    "@types/react-dom": "^16.9.8",
    "@types/react-redux": "^7.1.9",
    "@types/redux-mock-store": "^1.0.2",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.27.1",
    "husky": "^7.0.4",
    "lint-staged": "^13.0.1",
    "prettier": "^2.0.5",
    "stylelint": "^14.1.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "typescript": "~4.4.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "npm run typecheck",
      "npm run eslint",
      "npm run prettier"
    ],
    "*.js": "eslint --cache --fix",
    "*.scss": "stylelint --fix"
  },
  "ignore": [
    "node_modules",
    ".build"
  ]
}
